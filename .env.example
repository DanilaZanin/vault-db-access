# Copy to .env (or run `make env`, which fills every `changeme` with a random value).
# The stack REFUSES to start while any value is empty or still contains "changeme".

# Postgres bootstrap superuser: used only by the Postgres container itself.
POSTGRES_ADMIN_PASSWORD=changeme
# Non-superuser account Vault connects as (and rotates), and the portal's read-only table lister.
PG_MANAGER_PASSWORD=changeme
PG_INTROSPECT_PASSWORD=changeme

# ClickHouse bootstrap admin. WARNING: this is a FULL administrator of ClickHouse and, unlike the other
# accounts, it is reachable over the network (port 8123 is published on 127.0.0.1; on a shared network it is
# reachable by anything that can route to the container). Treat it like a root password, keep it out of the
# middleware (it is never passed to it) and restrict the ClickHouse port in any non-demo deployment.
# Below it: Vault's least-privilege manager account and the read-only introspection account.
CLICKHOUSE_ADMIN_PASSWORD=changeme
CLICKHOUSE_MANAGER_PASSWORD=changeme
CLICKHOUSE_INTROSPECT_PASSWORD=changeme

# Portal administrator (a Vault userpass account created by setup).
VDBA_ADMIN_USER=admin
VDBA_ADMIN_PASSWORD=changeme

# Demo only: accept plain-text (non-TLS) connections between the services on the internal docker network and
# between Vault and Postgres. For anything real remove this and set VDBA_PG_SSLMODE=verify-full (+ a CA via
# VDBA_PG_SSLROOTCERT), and put TLS in front of the portal. Setup refuses to run without one of the two.
VDBA_ALLOW_INSECURE=1

# Production settings (all optional in the demo; see README "Production checklist").
# VDBA_PUBLIC_ORIGIN=https://vdba.example.com   # the portal's external URL (TLS terminated in front of it)
# VDBA_COOKIE_SECURE=1
# VDBA_ALLOWED_ORIGINS=
# VDBA_PG_SSLMODE=verify-full
# VDBA_PG_SSLROOTCERT=/path/to/ca.pem            # path inside the vault AND middleware containers
# VDBA_CH_SECURE=1
# VDBA_CH_CA_CERT=/path/to/ca.pem
