# Copy to .env and fill in real values. Never commit the real .env.
#
# POSTGRES_SUPERUSER_PASSWORD / CLICKHOUSE_VAULTADMIN_PASSWORD are only consumed by
# `docker compose run --rm middleware python -m app.first_time_setup` (one-off setup).
# They are NOT read by the running app afterwards -- see README.md.
POSTGRES_SUPERUSER_PASSWORD=changeme
CLICKHOUSE_VAULTADMIN_PASSWORD=changeme

# Required for sessions to survive a container restart / to run more than one replica.
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=changeme
